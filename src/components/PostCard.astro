---
import { getSubcategoryLabel } from '../utils/subcategories';
import { getReadingTime } from '../utils/readingTime';
import { formatDate } from '../utils/formatDate';
import type { Category } from '../utils/categories';

// 기록형 글 목록의 한 줄. 카드·뱃지·썸네일은 두지 않는다 (DESIGN.md "Layout").
// 감싸는 쪽에서 class="post-log"를 주면 마지막 줄 아래 선이 그어진다.
interface Props {
  title: string;
  description: string;
  category: Category;
  subcategory?: string;
  pubDate: Date;
  slug: string;
  body?: string;
}

const { title, description, category, subcategory, pubDate, slug, body } = Astro.props;
const subLabel = subcategory ? getSubcategoryLabel(category, subcategory) : undefined;
const readingTime = body ? getReadingTime(body) : '';
const dateStr = formatDate(pubDate);
---

<article class="post-log-item">
  <time class="meta" datetime={pubDate.toISOString()}>{dateStr}</time>
  <div class="min-w-0">
    <h2 class="post-log-title">
      <a href={`/posts/${slug}/`} class="hover:text-(--color-accent) transition-colors">{title}</a>
    </h2>
    <p class="mt-1.5 text-[0.9375rem] leading-[1.65] text-(--color-text-secondary)">{description}</p>
    {(subLabel || readingTime) && (
      <p class="meta mt-2">{[subLabel, readingTime].filter(Boolean).join(' · ')}</p>
    )}
  </div>
</article>
