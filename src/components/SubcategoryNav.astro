---
import type { Category } from '../utils/categories';
import { subcategories } from '../utils/subcategories';

interface Props {
  category: Category;
  current?: string; // 현재 선택된 subcategory slug (없으면 "전체")
}

const { category, current } = Astro.props;
const subs = subcategories[category];
---

<nav class="flex flex-wrap gap-x-5 gap-y-1 mb-6 text-[0.9375rem]">
  <a
    href={`/${category}/`}
    aria-current={!current ? 'page' : undefined}
    class:list={[
      'transition-colors',
      !current ? 'text-(--color-text) font-semibold' : 'text-(--color-text-secondary) hover:text-(--color-text)',
    ]}
  >
    전체
  </a>
  {subs.map((sub) => (
    <a
      href={`/${category}/${sub.slug}/`}
      aria-current={current === sub.slug ? 'page' : undefined}
      class:list={[
        'transition-colors',
        current === sub.slug ? 'text-(--color-text) font-semibold' : 'text-(--color-text-secondary) hover:text-(--color-text)',
      ]}
    >
      {sub.label}
    </a>
  ))}
</nav>
