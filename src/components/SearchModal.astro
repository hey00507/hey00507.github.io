---
// 검색 모달과 스크립트. 페이지에 한 번만 넣는다 (버튼은 Search.astro)
---

<div id="search-modal" class="fixed inset-0 z-[100] hidden">
  <div id="search-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div class="relative max-w-xl mx-4 sm:mx-auto mt-12 sm:mt-20">
    <div class="bg-(--color-bg) border border-(--color-border) rounded-lg shadow-2xl overflow-hidden">
      <div id="search-container" class="p-4"></div>
    </div>
  </div>
</div>

<script is:inline>
  let pagefindLoaded = false;

  function openSearch() {
    const modal = document.getElementById('search-modal');
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    if (!pagefindLoaded) {
      pagefindLoaded = true;
      const base = '/';
      import(base + 'pagefind/pagefind-ui.js').then((mod) => {
        new (mod.PagefindUI || window.PagefindUI)({
          element: '#search-container',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: '검색어를 입력하세요...',
            zero_results: '검색 결과가 없습니다.',
          },
        });
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = base + 'pagefind/pagefind-ui.css';
        document.head.appendChild(link);
        setTimeout(() => {
          const input = document.querySelector('#search-container input');
          if (input) input.focus();
        }, 100);
      });
    } else {
      setTimeout(() => {
        const input = document.querySelector('#search-container input');
        if (input) input.focus();
      }, 50);
    }
  }

  function closeSearch() {
    document.getElementById('search-modal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  // 검색 버튼은 데스크톱·모바일 헤더에 하나씩 있어서 id 대신 data 속성으로 잡는다
  document.addEventListener('click', (e) => {
    if (e.target.closest('[data-search-btn]')) openSearch();
  });
  document.getElementById('search-backdrop').addEventListener('click', closeSearch);
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') closeSearch();
  });
</script>
