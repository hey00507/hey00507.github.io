---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts } from '../utils/posts';
import { formatMonthDay } from '../utils/formatDate';
import { buildSlugMap } from '../utils/slugs';

const allPosts = await getPublishedPosts();
const slugMap = buildSlugMap(allPosts);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 연도별 그룹핑
const grouped = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!grouped.has(year)) grouped.set(year, []);
  grouped.get(year)!.push(post);
}
// slot 안에서는 Astro 전역을 쓸 수 없어서(Astro 7) 미리 꺼내 둔다
const siteUrl = Astro.site;
---

<BaseLayout title="아카이브 - Ethan Devlog" description={`전체 ${posts.length}개 글 아카이브`}>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: '아카이브', description: `전체 ${posts.length}개 글 아카이브`, url: `${siteUrl}archive/`, mainEntity: { '@type': 'ItemList', numberOfItems: posts.length } })} slot="head" />
  <h1 class="text-3xl font-bold mb-8">아카이브</h1>
  {[...grouped.entries()].map(([year, yearPosts]) => (
    <section class="mb-10">
      <h2 class="text-xl mb-2">{year}</h2>
      <ul class="border-b border-(--color-border)">
        {yearPosts.map((post) => (
          <li class="border-t border-(--color-border) py-2.5 flex items-baseline gap-4">
            <time class="meta shrink-0" datetime={post.data.pubDate.toISOString()}>{formatMonthDay(post.data.pubDate)}</time>
            <a href={`/posts/${slugMap.get(post.id)}/`} class="font-medium hover:text-(--color-accent) transition-colors">{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
