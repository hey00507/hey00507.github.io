---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts } from '../../../utils/posts';
import { buildSlugMap } from '../../../utils/slugs';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const slugMap = buildSlugMap(allPosts);
  const seriesPosts = allPosts.filter((p) => p.data.series);

  const seriesGroup = new Map<string, typeof seriesPosts>();
  for (const post of seriesPosts) {
    const s = post.data.series!;
    if (!seriesGroup.has(s)) seriesGroup.set(s, []);
    seriesGroup.get(s)!.push(post);
  }

  return [...seriesGroup.entries()].map(([name, posts]) => ({
    params: { name },
    props: {
      name,
      slugMap: Object.fromEntries(slugMap),
      posts: posts.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()),
    },
  }));
}

const { name, posts, slugMap } = Astro.props;
---

<BaseLayout title={`${name} - Ethan Devlog`} description={`시리즈: ${name}`}>
  <div class="mb-8">
    <a href="/dev/" class="text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors">← 전체 글</a>
    <h1 class="text-3xl font-bold mt-2">{name}</h1>
    <p class="meta mt-2">시리즈 · 총 {posts.length}편</p>
  </div>
  <div class="post-log">
    {posts.map((post) => (
      <PostCard
        title={post.data.title}
        description={post.data.description}
        category={post.data.category}
        subcategory={post.data.subcategory}
        pubDate={post.data.pubDate}
        slug={slugMap[post.id]}
        body={post.body}
      />
    ))}
  </div>
</BaseLayout>
