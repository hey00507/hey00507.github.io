---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SubcategoryNav from '../../components/SubcategoryNav.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts } from '../../utils/posts';
import { buildSlugMap } from '../../utils/slugs';

const allPosts = await getPublishedPosts();
const slugMap = buildSlugMap(allPosts);
const posts = allPosts
  .filter((p) => p.data.category === 'dev')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 시리즈별 그룹핑
const seriesMap = new Map<string, typeof posts>();
const standalonePosts: typeof posts = [];
for (const post of posts) {
  if (post.data.series) {
    const s = post.data.series;
    if (!seriesMap.has(s)) seriesMap.set(s, []);
    seriesMap.get(s)!.push(post);
  } else {
    standalonePosts.push(post);
  }
}
// 시리즈 내부는 pubDate 오름차순
for (const [, sp] of seriesMap) {
  sp.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
}
// slot 안에서는 Astro 전역을 쓸 수 없어서(Astro 7) 미리 꺼내 둔다
const siteUrl = Astro.site;
---

<BaseLayout title="전체 글 - Ethan Devlog" description="업무에서 푼 문제, 개인 프로젝트, 공부 기록">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: '전체 글', description: '업무에서 푼 문제, 개인 프로젝트, 공부 기록', url: `${siteUrl}dev/`, mainEntity: { '@type': 'ItemList', numberOfItems: posts.length } })} slot="head" />
  <h1 class="text-3xl font-bold mb-2">전체 글</h1>
  <p class="text-(--color-text-secondary) mb-4">업무에서 푼 문제, 개인 프로젝트, 공부 기록</p>
  <SubcategoryNav category="dev" />

  {posts.length === 0 ? (
    <p class="text-(--color-text-secondary)">아직 글이 없습니다.</p>
  ) : (
    <>
      {/* 시리즈 섹션 */}
      {seriesMap.size > 0 && (
        <section class="mb-10">
          <h2 class="text-lg font-bold mb-3">시리즈</h2>
          <ul class="border-b border-(--color-border)">
            {[...seriesMap.entries()].map(([name, seriesPosts]) => (
              <li class="border-t border-(--color-border) py-3 flex flex-wrap items-baseline justify-between gap-x-4">
                <a href={`/dev/series/${encodeURIComponent(name)}/`} class="font-medium hover:text-(--color-accent) transition-colors">{name}</a>
                <span class="meta">{seriesPosts.length}편</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* 전체 글 목록 */}
      <section>
        {seriesMap.size > 0 && <h2 class="text-lg font-bold mb-3">전체 글</h2>}
        <div class="post-log">
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              category={post.data.category}
              subcategory={post.data.subcategory}
              pubDate={post.data.pubDate}
              slug={slugMap.get(post.id)!}
              body={post.body}
            />
          ))}
        </div>
      </section>
    </>
  )}
</BaseLayout>
