---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
// slot 안에서는 Astro 전역을 쓸 수 없어서(Astro 7) 미리 꺼내 둔다
const siteUrl = Astro.site;
---

<BaseLayout title="태그 - Ethan Devlog" description={`${tags.length}개 태그로 분류된 블로그 글 모음`} noindex>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: '태그', description: `${tags.length}개 태그로 분류된 블로그 글 모음`, url: `${siteUrl}tags/` })} slot="head" />
  <h1 class="text-3xl font-bold mb-8">태그</h1>
  <div class="meta flex flex-wrap gap-x-5 gap-y-2">
    {tags.map(([tag, count]) => (
      <a href={`/tags/${tag}/`} class="hover:text-(--color-accent) transition-colors">
        #{tag} <span class="opacity-60">{count}</span>
      </a>
    ))}
  </div>
</BaseLayout>
