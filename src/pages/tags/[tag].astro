---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts } from '../../utils/posts';
import { buildSlugMap } from '../../utils/slugs';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const slugMap = buildSlugMap(posts);
  const tags = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) tags.add(tag);
  }
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      slugMap: Object.fromEntries(slugMap),
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag } = Astro.params;
const { posts, slugMap } = Astro.props;
// slot 안에서는 Astro 전역을 쓸 수 없어서(Astro 7) 미리 꺼내 둔다
const siteUrl = Astro.site;
---

<BaseLayout title={`#${tag} - Ethan Devlog`} description={`#${tag} 태그가 포함된 ${posts.length}개의 글`} noindex>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: `#${tag}`, description: `#${tag} 태그가 포함된 ${posts.length}개의 글`, url: `${siteUrl}tags/${tag}/`, mainEntity: { '@type': 'ItemList', numberOfItems: posts.length } })} slot="head" />
  <div class="mb-8">
    <a href="/tags/" class="text-sm text-(--color-text-secondary) hover:text-(--color-text) transition-colors">← 전체 태그</a>
    <h1 class="text-3xl font-bold mt-2">#{tag}</h1>
    <p class="meta mt-2">{posts.length}편</p>
  </div>
  <div class="post-log">
    {posts.map((post) => (
      <PostCard
        title={post.data.title}
        description={post.data.description}
        category={post.data.category}
        subcategory={post.data.subcategory}
        pubDate={post.data.pubDate}
        slug={slugMap[post.id]}
        body={post.body}
      />
    ))}
  </div>
</BaseLayout>
